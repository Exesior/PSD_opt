# ignore file
*.log
*.gif
*.xlsx
*.png
*.npz
*.npy
*.pdf
*.tar.gz
*.pkl
*.keras
*.zip
*.pkl
*.json
!requirements.txt

# ignore ordner
__pycache__
myenv
docs/_build/
.codex/

*.html
*.csv
/config/all_test/Ray_Tune
/tests/config/Ray_Tune
tests/distribution_animation.gif
poetry.lock
/dist
*.7z

*.jpg
/optframework/utils/func_temp/config
*.sqlite
/examples/config/Ray_Tune
/docs/_build
/optframework/examples/config/Ray_Tune
/docs/api

*.h5
*.pt
*.gif
*.lock
*.whl
*.mdb
*.pptx
*.svg
*.mjs

# local virtualenv
.venv/

# WMCPBE Trials: generated debug-run text reports (*.csv/*.log outputs are
# already covered by the rules above). analyze_logs.py itself stays tracked.
mcpbe/src/wmcpbe/Trials/debug_logs/*.txt

# Ray Tune trial output. The two rules further up (/examples/config/Ray_Tune,
# /optframework/examples/config/Ray_Tune) are anchored to a directory layout
# that no longer exists; the current path is scripts/examples/config/Ray_Tune.
# Matching on the directory name catches it wherever it ends up.
**/Ray_Tune/

# Profiling and run logs that predate the *.log / *.svg rules above and were
# therefore committed once.
scripts/test/parallel.log
scripts/test/cpu_profile.svg

# ---------------------------------------------------------------------------
# Published repository = solver packages + studies/ (state of the thesis
# submission, 2026-11). Everything below stays on disk but out of the repo.
# ---------------------------------------------------------------------------

# Claude Code / agent working files
.claude/
.agents/

# Local trial, debug and archive folders
/Trials/
mcpbe/src/wmcpbe/Trials/
mcpbe/src/historical_versions/
mcpbe/docs/historical/

# Local helper scripts (hard-coded local paths)
/run_search.py
/run_jit_search.py
/search_jit.py
/search_nucleation.py
/search_prepare_break.py
/run_tests.bat

# Ray Tune output, wherever a run writes it
*tfevents*
.validate_storage_marker

# Study outputs (regenerable). The inputs are re-included at the end.
studies/optimization/wet_granulation_ray/
studies/optimization/wet_granulation_opt_results*/
studies/optimization/kernel_vergleich_input/
studies/optimization/kernel_vergleich_results/
studies/sensitivity/pruefung_R_ncomp500/
studies/sensitivity/FRAGEN_FUER_MORGEN.md
studies/merger/npz/
studies/merger/seriell/
mcpbe/studies/operator_splitting/results/

# Processed measurement data for the fit: inputs, must be tracked (the
# repo-wide *.xlsx rule above would otherwise hide them)
!studies/optimization/data/*.xlsx
